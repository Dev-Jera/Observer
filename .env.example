# CitizenEye Server Configuration

# Database — use SQLite locally, Render Postgres in production:
# Local:      DATABASE_URL=sqlite:///./citizeneye.db
# Production: DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./citizeneye.db

# Google Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# CORS origins allowed to call this API (comma-separated)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Digital Eye scrape interval (minutes)
SCRAPE_INTERVAL_MINUTES=15

# Sunbird AI translation (used by the mobile app, kept here for reference)
SUNBIRD_API_KEY=your-sunbird-key-here
